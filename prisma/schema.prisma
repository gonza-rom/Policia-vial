// Prisma schema — Sistema de Actas Viales, Huillapima (Policía de Catamarca)
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolAgente {
  AGENTE
  JEFE
  ADMIN
}

enum EstadoGuardia {
  ACTIVA
  CERRADA
}

enum CategoriaInfraccion {
  DOCUMENTACION
  ESTADO_RODADO
  ALCOHOLEMIA_CONDUCTA
  OTRA
}

enum GravedadInfraccion {
  LEVE
  GRAVE
  GRAVISIMA
}

enum TipoRodado {
  AUTO
  MOTO
  PICKUP
  CARGA
  PASAJEROS
  EMERGENCIAS
  OTRO
}

enum TipoRetencion {
  NINGUNA
  LICENCIA
  VEHICULO
  LICENCIA_Y_VEHICULO
}

enum EstadoActa {
  PENDIENTE_FIRMA
  FIRMADA
  REMITIDA_RENTAS
  ANULADA
}

enum TipoActa {
  MUNICIPAL
  CONTRAVENCIONAL
}

enum TipoCampoContravencional {
  TEXTO
  TEXTO_LARGO
  NUMERO
  FECHA
  HORA
  SELECT
}

enum TipoRequerimiento {
  PERSONA
  VEHICULO
}

enum ModalidadRelevamiento {
  FINES_LARGOS
  DIA_VIRGEN
  SEMANA_ESTUDIANTIL
  FESTIVALES
  PONCHO
}

/// Jurisdicción municipal de un acta tipo MUNICIPAL. No aplica a la
/// CONTRAVENCIONAL (Ley Provincial 5171/05, sin distinción municipal).
enum Jurisdiccion {
  CAPITAL
  HUILLAPIMA
  LA_PUERTA
}

/// HABITUAL: el agente trabaja en su puesto de siempre (el de su guardia).
/// OTRA_JURISDICCION: está reforzando/rotando en otro puesto — el sistema
/// no lo autoriza de antemano, pero exige que declare el motivo (ver
/// Acta.motivoOtraJurisdiccion / Procedimiento.motivoOtraJurisdiccion) para
/// que quede trazable quién trabajó dónde y por qué.
enum ModalidadTrabajo {
  HABITUAL
  OTRA_JURISDICCION
}

enum TipoProcedimiento {
  ORDEN_JUDICIAL
  SECUESTRO
  DEMORA
  ARRESTO
  DETENCION
  UBICACION_PARADERO
  ESTUPEFACIENTES
}

enum MedioTransporte {
  VEHICULO
  CAMINATA
  BICICLETA
  CABALLO
  COLECTIVO
  CAMION
}

enum Sexo {
  FEMENINO
  MASCULINO
  NO_BINARIO
}

model Agente {
  id             String    @id @default(cuid())
  legajo         String    @unique
  authEmail      String    @unique
  nombreApellido String
  grado          String?
  rol            RolAgente @default(AGENTE)
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  // Jefe a cargo: el que dio de alta al agente y lo gestiona.
  jefeId  String?
  jefe    Agente?  @relation("JefeAgentes", fields: [jefeId], references: [id])
  agentes Agente[] @relation("JefeAgentes")

  guardias       Guardia[]
  actas          Acta[]
  requerimientos Requerimiento[]
  relevamientos  Relevamiento[]
  procedimientos Procedimiento[]

  @@index([jefeId])
}

model Puesto {
  id        String   @id @default(cuid())
  codigo    String?  @unique
  nombre    String
  orden     Int      @default(0)
  kmRuta    String?
  ubicacion String?
  latitud   Decimal? @db.Decimal(9, 6)
  longitud  Decimal? @db.Decimal(9, 6)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Jurisdicciones municipales habituales de este puesto (vacío = sin
  // acceso habitual a actas municipales, salvo modalidad OTRA_JURISDICCION).
  // La acta contravencional no está restringida por jurisdicción.
  jurisdiccionesMunicipales Jurisdiccion[] @default([])

  guardias              Guardia[]
  actas                 Acta[]          @relation("PuestoOrigenActa")
  actasTrabajo          Acta[]          @relation("PuestoTrabajoActa")
  requerimientos        Requerimiento[]
  relevamientos         Relevamiento[]
  procedimientos        Procedimiento[] @relation("PuestoOrigenProcedimiento")
  procedimientosTrabajo Procedimiento[] @relation("PuestoTrabajoProcedimiento")
}

model Guardia {
  id          String        @id @default(cuid())
  agenteId    String
  agente      Agente        @relation(fields: [agenteId], references: [id])
  puestoId    String
  puesto      Puesto        @relation(fields: [puestoId], references: [id])
  turnoInicio DateTime      @default(now())
  turnoFin    DateTime?
  horaCierre  DateTime?
  estado      EstadoGuardia @default(ACTIVA)
  notasCierre String?       @db.Text
  createdAt   DateTime      @default(now())

  actas Acta[]

  @@index([agenteId, estado])
}

model InfraccionCatalogo {
  id          String              @id @default(cuid())
  categoria   CategoriaInfraccion
  descripcion String
  detalle     String?
  gravedad    GravedadInfraccion
  montoBase   Decimal             @db.Decimal(12, 2)
  orden       Int                 @default(0)
  activo      Boolean             @default(true)

  actas ActaInfraccion[]
}

model Acta {
  id     String   @id @default(cuid())
  numero Int      @unique @default(autoincrement())
  tipo   TipoActa @default(MUNICIPAL)

  guardiaId String
  guardia   Guardia @relation(fields: [guardiaId], references: [id])
  agenteId  String
  agente    Agente  @relation(fields: [agenteId], references: [id])
  // Puesto de ORIGEN (el de la guardia) — nunca cambia por trabajar en otra
  // jurisdicción, así se preserva siempre de dónde es el agente.
  puestoId  String
  puesto    Puesto  @relation("PuestoOrigenActa", fields: [puestoId], references: [id])

  // Jurisdicción municipal del acta (solo aplica a tipo = MUNICIPAL).
  jurisdiccion Jurisdiccion?

  // Modalidad bajo la que se labró: HABITUAL (puesto de origen) u
  // OTRA_JURISDICCION (refuerzo/rotación). En este segundo caso,
  // puestoTrabajo es dónde se hizo realmente la intervención y
  // motivoOtraJurisdiccion es obligatorio (autodeclarado, sin
  // autorización previa — ver enum ModalidadTrabajo).
  modalidadTrabajo      ModalidadTrabajo @default(HABITUAL)
  puestoTrabajoId       String?
  puestoTrabajo         Puesto?          @relation("PuestoTrabajoActa", fields: [puestoTrabajoId], references: [id])
  motivoOtraJurisdiccion String?         @db.Text

  fecha        DateTime @default(now())
  lugarControl String?

  // --- Campos del acta MUNICIPAL (Ordenanza 385/12) ---
  // Datos del conductor
  conductorNombre        String?
  conductorDni           String?
  conductorEdad          Int?
  conductorDomicilio     String?
  conductorLicenciaNro   String?
  conductorLicenciaClase String?
  conductorExpedidoPor   String?

  // Datos del vehículo
  vehiculoDominio     String?
  vehiculoMarcaModelo String?
  vehiculoTipo        TipoRodado?
  // Solo tiene valor cuando vehiculoTipo = OTRO.
  vehiculoTipoOtro    String?
  vehiculoRemitidoA   String?

  otrosDatosAmpliatorios String? @db.Text

  // Liquidación
  montoBase           Decimal? @db.Decimal(12, 2)
  porcentajeDescuento Decimal  @default(40) @db.Decimal(5, 2)
  montoConDescuento   Decimal? @db.Decimal(12, 2)

  // --- Campos del acta CONTRAVENCIONAL (Ley Provincial 5171/05) ---
  // Clave/valor según el esquema configurable en CampoContravencional.
  datosContravencional Json?

  // Evidencia y firmas (compartido por ambos tipos; el tercer firmante
  // —"Secretario Autorizante"— solo aplica al acta contravencional)
  fotoVehiculoUrl         String?
  fotoDocumentoUrl        String?
  firmaInfractorUrl       String?
  firmaActuanteUrl        String?
  firmaSecretarioUrl      String?
  infractorSeNiegaAFirmar Boolean @default(false)

  // Retención preventiva
  retencionPreventiva Boolean       @default(false)
  tipoRetencion       TipoRetencion @default(NINGUNA)

  // Alcoholemia
  alcoholemiaGraduacion Decimal? @db.Decimal(4, 2)

  estado EstadoActa @default(PENDIENTE_FIRMA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  infracciones ActaInfraccion[]

  @@index([fecha])
  @@index([estado])
  @@index([tipo])
  @@index([guardiaId])
  @@index([vehiculoDominio])
  @@index([conductorDni])
}

/// Esquema editable de campos del acta contravencional (Ley Provincial
/// 5171/05): mientras no llegue el formulario oficial definitivo, se puede
/// ajustar acá (orden, etiquetas, secciones) sin tocar código.
model CampoContravencional {
  id        String                   @id @default(cuid())
  clave     String                   @unique
  etiqueta  String
  seccion   String
  tipo      TipoCampoContravencional @default(TEXTO)
  // Solo se usa cuando tipo = SELECT: las opciones de la lista desplegable.
  opciones  String[]                 @default([])
  orden     Int                      @default(0)
  requerido Boolean                  @default(false)
  activo    Boolean                  @default(true)
}

model ActaInfraccion {
  id               String             @id @default(cuid())
  actaId           String
  acta             Acta               @relation(fields: [actaId], references: [id], onDelete: Cascade)
  infraccionId     String
  infraccion       InfraccionCatalogo @relation(fields: [infraccionId], references: [id])
  detalleOperativo String?

  @@unique([actaId, infraccionId])
}

/// Pedido de captura/secuestro sobre una persona o un vehículo. No depende
/// de una guardia abierta — es un "cartel" consultable en cualquier momento,
/// asociado solo al puesto, la fecha y quién lo cargó.
model Requerimiento {
  id     String            @id @default(cuid())
  numero Int               @unique @default(autoincrement())
  tipo   TipoRequerimiento

  puestoId String
  puesto   Puesto   @relation(fields: [puestoId], references: [id])
  agenteId String
  agente   Agente   @relation(fields: [agenteId], references: [id])
  fecha    DateTime @default(now())

  // 4 campos de texto libre — cada caso es distinto, no hay casilleros fijos.
  descripcion   String  @db.Text
  datosOrden    String? @db.Text
  motivo        String? @db.Text
  observaciones String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo])
  @@index([fecha])
  @@index([puestoId])
}

/// Conteo rápido de personas en operativos puntuales (fin de semana largo,
/// peregrinación), para no mezclarlo con las actas. Dos modalidades con
/// campos distintos: Fines Largos (cantidad + procedencia) y Día de la
/// Virgen (medio de transporte + sexo + procedencia). `cantidadPersonas`
/// sirve para las dos — un registro puede representar a un grupo entero
/// con los mismos datos, no necesariamente una persona por fila.
model Relevamiento {
  id        String                @id @default(cuid())
  modalidad ModalidadRelevamiento

  cantidadPersonas Int              @default(1)
  procedencia      String?
  medioTransporte  MedioTransporte?
  sexo             Sexo?

  puestoId String
  puesto   Puesto   @relation(fields: [puestoId], references: [id])
  agenteId String
  agente   Agente   @relation(fields: [agenteId], references: [id])
  fecha    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modalidad])
  @@index([fecha])
  @@index([puestoId])
}

/// Órdenes judiciales, secuestros, demoras, arrestos, detenciones, ubicación
/// y paradero, y estupefacientes. Mismo patrón que Requerimiento: no depende
/// de una guardia abierta, es un registro puntual asociado a puesto/agente/
/// fecha. Campos genéricos comunes a las 7 categorías — si en el futuro
/// aparece un formulario oficial distinto por categoría, se ajusta puntual.
model Procedimiento {
  id     String            @id @default(cuid())
  numero Int               @unique @default(autoincrement())
  tipo   TipoProcedimiento

  // Puesto de ORIGEN (de dónde es el agente) y agente responsable.
  puestoId String
  puesto   Puesto   @relation("PuestoOrigenProcedimiento", fields: [puestoId], references: [id])
  agenteId String
  agente   Agente   @relation(fields: [agenteId], references: [id])
  fecha    DateTime @default(now())

  // Igual mecánica que en Acta: HABITUAL u OTRA_JURISDICCION con motivo
  // autodeclarado — ver enum ModalidadTrabajo.
  modalidadTrabajo       ModalidadTrabajo @default(HABITUAL)
  puestoTrabajoId        String?
  puestoTrabajo          Puesto?          @relation("PuestoTrabajoProcedimiento", fields: [puestoTrabajoId], references: [id])
  jurisdiccion           Jurisdiccion?
  motivoOtraJurisdiccion String?          @db.Text

  // Datos de la persona y/o vehículo involucrado (ambos opcionales: según
  // la categoría, el procedimiento puede ser solo sobre una persona, solo
  // sobre un vehículo, o ninguno de los dos todavía identificado).
  personaNombre   String?
  personaDni      String?
  vehiculoDominio String?

  descripcion   String  @db.Text
  datosOrden    String? @db.Text
  observaciones String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo])
  @@index([fecha])
  @@index([puestoId])
}

/// Registro de "última edición gana" cuando una sincronización offline pisa
/// una edición más nueva que ya estaba en el servidor. La versión que
/// prevalece queda en Acta; la descartada se guarda acá para no perderla.
model ConflictoSincronizacion {
  id         String   @id @default(cuid())
  actaId     String
  agenteId   String
  descartado Json
  motivo     String
  creadoEn   DateTime @default(now())

  @@index([actaId])
}
