# ══════════════════════════════════════════════════════════
# Policia Vial — Next.js + Prisma + Supabase + Cloudinary
# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas el .env real (con secretos) al repositorio.
# ══════════════════════════════════════════════════════════

NEXT_PUBLIC_SITE_NAME=Policia-Vial
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_EMAIL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → Database
# Pooler transaccional (IPv4-only) — usado por la app en runtime
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler de sesión / conexión directa — usado por el CLI de Prisma (migrate/db push/seed)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Cloudinary → necesario para subir fotos del vehículo/documentación y firmas
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ORS_API_KEY=

# Contraseña con la que el seed crea los agentes de prueba
SEED_DEFAULT_PASSWORD=CambiarEsto123!
